# R session files
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# renv: commit renv.lock, never the installed library
renv/library/
renv/staging/

# Data
# Raw data IS committed (small teaching files), so students can clone and run.
# Processed data is NOT committed: it is rebuilt by the cleaning scripts.
data/processed/**
!data/processed/**/
!data/processed/**/README.md
!data/processed/.gitkeep

# Generated outputs: rebuilt by scripts and Quarto
outputs/**
!outputs/**/
!outputs/**/.gitkeep

# Quarto build artefacts
/.quarto/
**/*.quarto_ipynb
**/*_files/
workshops/**/*.html
workshops/**/*.pdf
workshops/**/*.docx

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak

# Created when R draws plots outside RStudio
Rplots.pdf
